# Local dev: in-memory store, inline processing, demo orders. Only an LLM key is required.
ENV=local
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
API_TOKEN=dev-token

# Or use Bedrock with your AWS credentials:
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL=anthropic.claude-opus-5-5
# AWS_REGION=us-east-1

# Optional real integrations
# GLADLY_BASE_URL=https://yourorg.gladly.com
# GLADLY_API_USER=bot@yourorg.com
# GLADLY_API_TOKEN=...
# GLADLY_WEBHOOK_TOKEN=...   # also set as the X-Webhook-Token header on the Gladly webhook
# SHOPIFY_SHOP=yourshop.myshopify.com
# SHOPIFY_TOKEN=shpat_...
